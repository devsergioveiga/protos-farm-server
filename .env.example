# Copie este arquivo para .env e ajuste os valores.
# O docker-compose lê .env automaticamente (variáveis abaixo).

# PostgreSQL (container)
POSTGRES_USER=protos
POSTGRES_PASSWORD=protos_secret
POSTGRES_DB=protos_farm

# Porta no host para o Postgres (5433 para não conflitar com Postgres local em 5432)
POSTGRES_PORT=5433

# CORS - origem permitida (ex: http://localhost:5173 em dev)
# CORS_ORIGIN=http://localhost:5173

# Connection string (usado por Drizzle e health check)
# Para Docker: postgresql://protos:protos_secret@postgres:5432/protos_farm
# Para local: postgresql://protos:protos_secret@localhost:5433/protos_farm
DATABASE_URL=postgresql://protos:protos_secret@localhost:5433/protos_farm
